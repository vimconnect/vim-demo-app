{
  "name": "vim-sdk-demo-app",
  "version": "1.0.0",
  "description": "Reference implementation for building applications with the Vim Connect App SDK",
  "license": "MIT",
  "homepage": "https://developer-docs.getvim.ai",
  "keywords": [
    "vim-connect",
    "sdk",
    "demo",
    "nextjs",
    "healthcare",
    "ehr",
    "ehr-integration"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "next dev -p 8080",
    "dev:local-sdk": "bash ../scripts/dev-demo-local-sdk.sh",
    "build-deps": "pnpm --filter @vim-connect/runtime-types run build && pnpm --filter @getvim/sdk run build",
    "build": "next build",
    "start": "next start -p 8080",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vimconnect/app-sdk": "0.4.58",
    "next": "^16.2.12",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.14.10",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^25.0.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vimconnect/vim-demo-app.git"
  }
}
